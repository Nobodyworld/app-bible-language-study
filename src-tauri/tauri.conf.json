{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible App Reader",
  "version": "../package.json",
  "identifier": "com.nobodyworld.bibleappreader",
  "mainBinaryName": "bible-app-reader",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../.desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bible App Reader",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "devtools": false,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "copyright": "Copyright Nobody Production",
    "shortDescription": "Local-first Bible reader and language study desktop preview.",
    "longDescription": "Unsigned public-preview Windows desktop shell for the local-first Bible App Reader.",
    "resources": {
      "../.desktop-resources/data/": "data/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
